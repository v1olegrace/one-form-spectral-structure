    given-names: "Mauro"
    alias: "Viole"
    affiliation: "Independent researcher, Botucatu, SP, Brazil"
version: "0.4"
date-released: "2026-09-29"
license: MIT
keywords:
  - generalized global symmetries
  - one-form symmetry
  - static potential
  - Laplace transform
  - moment problem
  - weak gravity conjecture
