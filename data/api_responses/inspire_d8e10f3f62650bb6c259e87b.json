{"hits":{"hits":[{"updated":"2026-01-06T19:24:28.564713+00:00","created":"2022-07-06T03:20:42.706276+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/2106233?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/2106233?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/2106233?format=latex-us","json":"https://inspirehep.net/api/literature/2106233?format=json","json-expanded":"https://inspirehep.net/api/literature/2106233?format=json-expanded","cv":"https://inspirehep.net/api/literature/2106233?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A2106233"},"metadata":{"citation_count":33,"authors":[{"full_name_unicode_normalized":"gouttenoire, yann","full_name":"Gouttenoire, Yann","curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/authors/1808370"},"affiliations":[{"curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/institutions/902770"},"value":"DESY"},{"curated_relation":true,"record":{"$ref":"https://inspirehep.net/api/institutions/902832"},"value":"Hamburg U."}],"last_name":"Gouttenoire","ids":[{"schema":"INSPIRE BAI","value":"Yann.Gouttenoire.1"}],"signature_block":"GATANARy","first_name":"Yann","uuid":"c32788a0-2e1b-4020-bf49-d182aeda385a","recid":1808370}],"abstracts":[{"source":"arXiv","value":"This book provides a thorough survey of the important questions at the interface between theoretical particle physics and cosmology. After discussing the theoretical and experimental physics revolution that led to the rise of the Standard Model in the past century, this volume reviews all major open puzzles, like the hierarchy problem, the small value of the cosmological constant, the matter-antimatter asymmetry, or the dark matter problem, and presents the state-of-the-art in the proposed solutions, with an extensive bibliography. This manuscript emphasises the fields of thermal dark matter, cosmological first-order phase transitions and gravitational-wave signatures. Comprehensive and encyclopedic, this book could be a rich resource for both researchers and students entering the field. In addition to the reviews composing two third of the material, one third presents the original PhD research work of the author.","abstract_source_suggest":{"input":"arXiv"}}],"control_number":2106233,"dois":[{"value":"10.1007/978-3-031-11862-3"}],"titles":[{"source":"arXiv","title":"Beyond the Standard Model Cocktail"}],"arxiv_eprints":[{"categories":["hep-ph","astro-ph.CO","gr-qc","hep-ex","hep-th"],"value":"2207.01633"}],"earliest_date":"2022-07-04","document_type":["book"]},"id":"2106233"}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?sort=mostcited&q=correlation%20inequalities%20lattice%20gauge%20theory%20upper%20bound%20potential&size=25&page=1&fields=titles,authors,arxiv_eprints,dois,publication_info,abstracts,citation_count,earliest_date,document_type,control_number","bibtex":"https://inspirehep.net/api/literature/?sort=mostcited&q=correlation%20inequalities%20lattice%20gauge%20theory%20upper%20bound%20potential&size=25&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?sort=mostcited&q=correlation%20inequalities%20lattice%20gauge%20theory%20upper%20bound%20potential&size=25&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?sort=mostcited&q=correlation%20inequalities%20lattice%20gauge%20theory%20upper%20bound%20potential&size=25&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?sort=mostcited&q=correlation%20inequalities%20lattice%20gauge%20theory%20upper%20bound%20potential&size=25&page=1&fields=titles,authors,arxiv_eprints,dois,publication_info,abstracts,citation_count,earliest_date,document_type,control_number&format=json","json-expanded":"https://inspirehep.net/api/literature/?sort=mostcited&q=correlation%20inequalities%20lattice%20gauge%20theory%20upper%20bound%20potential&size=25&page=1&format=json-expanded","cv":"https://inspirehep.net/