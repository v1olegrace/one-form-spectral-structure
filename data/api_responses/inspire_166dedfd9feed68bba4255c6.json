ited Kingdom"},{"value":"Department of Physics,Faculty of Science and Engineering,Swansea University,Singleton Park,SA2 8PP,Swansea,United Kingdom"}],"full_name_unicode_normalized":"piai, maurizio","full_name":"Piai, Maurizio","record":{"$ref":"https://inspirehep.net/api/authors/993462"},"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/903240"},"value":"Swansea U."}],"ids":[{"schema":"ORCID","value":"0000-0002-2251-0111"},{"schema":"INSPIRE BAI","value":"Maurizio.Piai.1"}],"last_name":"Piai","uuid":"db42d4ef-1534-4b16-b567-1600cff9ed2d","first_name":"Maurizio","recid":993462},{"raw_affiliations":[{"value":"Centre for Mathematical Sciences,University of Plymouth,Plymouth,PL4 8AA,United Kingdom"}],"full_name_unicode_normalized":"vadacchino, davide","full_name":"Vadacchino, Davide","record":{"$ref":"https://inspirehep.net/api/authors/1277616"},"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/908532"},"value":"Plymouth U., Math. Stat. Dept."}],"ids":[{"schema":"ORCID","value":"0000-0002-5783-5602"},{"schema":"INSPIRE BAI","value":"Davide.Vadacchino.1"}],"last_name":"Vadacchino","uuid":"5c8cbc37-9bae-43fe-ac77-d2200dc10354","first_name":"Davide","recid":1277616},{"raw_affiliations":[{"value":"Technical University of Munich,TUM School of Natural Sciences,Physics Department,James-Franck-Straße 1,85748 Garching,Germany"},{"value":"Centre for Quantum Fields and Gravity,Faculty of Science and Engineering,Swansea University,Singleton Park,SA2 8PP,Swansea,United Kingdom"},{"value":"Department of Physics,Faculty of Science and Engineering,Swansea University,Singleton Park,SA2 8PP,Swansea,United Kingdom"}],"full_name_unicode_normalized":"zierler, fabian","full_name":"Zierler, Fabian","record":{"$ref":"https://inspirehep.net/api/authors/1933762"},"affiliations":[{"record":{"$ref":"https://inspirehep.net/api/institutions/903037"},"value":"Munich, Tech. U."},{"record":{"$ref":"https://inspirehep.net/api/institutions/903240"},"value":"Swansea U."}],"ids":[{"schema":"ORCID","value":"0000-0002-8670-4054"},{"schema":"INSPIRE BAI","value":"Fabian.Zierler.1"}],"last_name":"Zierler","uuid":"1001bde1-cdd5-48b4-9574-156c3a019909","first_name":"Fabian","recid":1933762}],"abstracts":[{"source":"arXiv","value":"We apply Lüscher's method to the vector channel of the scattering amplitude of Pseudo-Nambu-Goldstone-Bosons (PNGBs), in the $Sp(4)$ lattice gauge theory coupled to $N_f=2$ flavors of Wilson-Dirac fundamental fermions. We generalize existing algorithms and numerical implementations of the method, to adapt them to this prominent candidate for the completion of proposed extensions of the Standard Model (SM). We present the first ab initio measurements of key properties of the vector resonances in the theory, including the coupling to the PNGBs, that are relevant to direct and indirect new physics searches, both for composite Higgs models (CHMs), as well as for strongly interacting massive particle (SIMP) realizations of dark matter. We also present a global update of the spectroscopy of the mesons in the theory, improving both the statistics and analysis systematics in respect to previous lattice measurements reported in the literature.","abstract_source_suggest":{"input":"arXiv"}}],"control_number":3168339,"titles":[{"source":"arXiv","title":"Resonant scattering in two-flavored Sp(4) lattice gauge theories"}],"arxiv_eprints":[{"categories":["hep-lat","hep-ph"],"value":"2606.14546"}],"earliest_date":"2026-06-12","document_type":["article"]},"updated":"2026-07-17T16:14:39.601142+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/3168339?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/3168339?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/3168339?format=latex-us","json":"https://inspirehep.net/api/literature/3168339?format=json","json-expanded":"https://inspirehep.net/api/literature/3168339?format=json-expanded","cv":"https://inspirehep.net/api/literat